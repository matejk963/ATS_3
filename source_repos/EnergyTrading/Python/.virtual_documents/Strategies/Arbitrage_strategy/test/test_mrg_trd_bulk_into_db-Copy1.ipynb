def group_trades(df_tr, agg_dict):
    # Group trades
    df_tr['count'] = 1
    df_tr['price'] *= df_tr['volume']
    df_tr = df_tr.groupby(df_tr.index).agg(agg_dict)
    df_tr['price'] /= df_tr['volume']
    return df_tr.loc[:, ['price', 'volume', 'action', 'broker_id']]


