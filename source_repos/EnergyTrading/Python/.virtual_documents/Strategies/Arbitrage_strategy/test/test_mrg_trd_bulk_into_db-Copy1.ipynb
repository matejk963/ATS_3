    df_aux['contract']=key
    #df_aux['broker_id']=df_aux['broker_id'].replace(6, 4)
    result.append(df_aux)

df=pd.concat(result)
df['broker_id']=df['broker_id'].replace(6, 4)
df['contract'].value_counts()


